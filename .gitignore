__pycache__/
*.pyc
.venv/

# videos (large: user recordings + reference downloads)
*.mp4

# throwaway analysis scripts (logic to be promoted into kovaak_tracker/)
_tmp_*.py

# macOS filesystem metadata
.DS_Store

# webapp local SQLite (dev/test 产物)
aiming_cookie*.db
aiming_cookie*.db-shm
aiming_cookie*.db-wal

# taste-skill (frontend design skill — development tool, not project code)
.agents/
.claude/skills/
skills-lock.json

# superpowers brainstorm mockups (design exploration, not project code)
.superpowers/

# local research evidence and generated snapshots (kept outside product commits)
.firecrawl/
artifacts/

# secrets (LLM API keys etc.)
.env
.env.*
*.secret

# vendored pi (third_party/pi) — never commit installed deps
third_party/pi/node_modules/
third_party/pi/**/node_modules/
webapp/coach-runtime/node_modules/

# session recordings under data/ stay tracked (override *.mp4 above)
!data/*.mp4

# dev server logs
webapp/frontend/mock-*.log
webapp/frontend/*.err.log
webapp/frontend/*.out.log
