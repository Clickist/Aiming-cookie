  "new_entries": [
    {
      "target_entry_ref": "knowledge:community.bardpill-accuracy-anchored-progression@1",
      "source_articles": ["bardpill"],
      "reason": "Named training method with a single explicit dial (pace gated on kept accuracy); baseline Stats plus matched retest already observe everything it needs, so it enters at full capability including scenario prescription."
    },
    {
      "target_entry_ref": "knowledge:community.speed-vs-evasive-switching@1",
      "source_articles": ["speed-switching", "switching"],
      "reason": "Switching-family subtype taxonomy (transition rate vs durable-target re-tracking) that lets prescriptions target the right scenario variant; also absorbs the TTK-to-family-lean heuristic."
    },
    {
      "target_entry_ref": "knowledge:community.reading-vs-execution-decomposition@1",
      "source_articles": ["dodge-guide"],
      "reason": "Reading/execution split plus the trainer boundary (bots neither react nor adapt) constrains attribution for reactive and dynamic families: trainer data cannot measure the reading half."
    },
    {
      "target_entry_ref": "knowledge:community.accuracy-multiplied-scoring@1",
      "source_articles": ["acc-based-scoring"],
      "reason": "Scoring-rule semantics making the score-up-accuracy-down shape interpretable from Stats alone; registered the signal plus an alias so query_registry retrieves it."
    },
    {
      "target_entry_ref": "knowledge:community.edge-tracking-underaim@1",
      "source_articles": ["edge-tracking"],
      "reason": "Deliberate trailing-edge placement as an alternative explanation for tracking-lag shapes; explanation_only because target-relative geometry is unavailable in baseline data."
    },
    {
      "target_entry_ref": "knowledge:community.overshoot-sensitivity-trigger@1",
      "source_articles": ["over-flicking"],
      "reason": "High-frequency community trigger (persistent visual overshoot on a long-unchanged sensitivity) feeding the existing single-variable sensitivity experiment; visual overshoot stays user-reported only."
    },
    {
      "target_entry_ref": "knowledge:community.vrt-response-floor@1",
      "source_articles": ["vrt", "reactivity"],
      "reason": "Physiological response floor under reactivity; expectation management so near-floor reacquisition times are not read as large trainable deficits."
    },
    {
      "target_entry_ref": "knowledge:community.target-angular-demand-math@1",
      "source_articles": ["angles-guide"],
      "reason": "Only the hand-speed-to-cm/360 conversion half is actionable (input plus settings); the target-angular-rate half is recorded as a limitation because target geometry is unavailable."
    },
    {
      "target_entry_ref": "knowledge:community.strafe-relative-speed-ladder@1",
      "source_articles": ["strafe-aim-guide"],
      "reason": "Relative-speed ordering of strafe-aim forms, promoted from deferred on user confirmation; explanation_only and bound to the movement outcome-only boundary."
    }
  ],
