{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aiming Cookie",
  "version": "0.1.3",
  "identifier": "com.aimingcookie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aiming Cookie",
        "width": 1280,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost aiming-cookie-media: http://aiming-cookie-media.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/sessions/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
