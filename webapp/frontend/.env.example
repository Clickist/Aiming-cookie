# Copy to .env.local for `next dev`. Restart Next after changing env vars.

# Browser API calls stay relative to /api and are proxied by next.config.ts
# to the local FastAPI backend on port 8000.

# Slice 1 dev shim — the backend reads X-User-Id from this header (one job per
# user at a time). Replace with Clerk session in slice 3.
NEXT_PUBLIC_USER_ID=dev
