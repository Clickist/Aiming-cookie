{
  "name": "aiming-cookie-frontend",
  "version": "1.2.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "set AIMING_COOKIE_API_MODE=mock&& set NEXT_PUBLIC_AIMING_COOKIE_API_MODE=mock&& next dev",
    "build": "next build",
    "build:tauri": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-tauri-frontend.ps1",
    "start": "next start",
    "lint": "tsc --noEmit",
    "sync-types": "node scripts/sync-api-types.mjs",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "node --import ../../third_party/pi/node_modules/tsx/dist/loader.mjs --test lib/*.test.ts mocks/*.test.ts",
    "test:contracts": "node --import ../../third_party/pi/node_modules/tsx/dist/loader.mjs --test tests/*.test.{ts,tsx}",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.7.0"
  }
}
